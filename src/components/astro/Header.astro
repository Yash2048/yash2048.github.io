---
import ThemeButton from "../svelte/ThemeButton.svelte";
import { Icon } from "astro-icon/components";
---

<header>
    <nav>
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/projects">Projects</a></li>
            <li><a href="/cli">CLI</a></li>
            <li><a href="/blog">Blog</a></li>
            <li><a href="/about">About</a></li>
        </ul>
        <button class="menu-toggle">
            <Icon width="24" height="24" name="nav" />
        </button>
    </nav>
    <ThemeButton client:load />
</header>

<style>
    :global(.dark-light-mode) {
        justify-self: center;
    }
    :global([data-icon]) {
        color: var(--secondary);
    }
    header,
    nav,
    ul {
        display: flex;
    }

    header {
        background-color: var(--primary);
        padding-block: 1rem;
        justify-content: flex-end;
        padding-inline: 1rem;
        min-height: 5rem;
        gap: 1rem;
    }
    nav {
        border-radius: 0.5rem;
        justify-content: flex-end;
    }
    ul {
        border-radius: 0.5rem;

        padding: 0;
        background-color: var(--secondary);
        list-style: none;
    }
    li {
        &:first-child {
            border-radius: 0.5rem 0 0 0.5rem;
        }
        &:last-child {
            border-radius: 0 0.5rem 0.5rem 0;
        }

        transition: all ease 0.15s;

        &:hover,
        &:has(a:focus-visible) {
            background-color: var(--accent);
            box-shadow: inset 0 0 0 1px var(--bg);
            a {
                outline: none;
                color: var(--bg);
            }
        }
    }
    a {
        display: block;
        padding-block: 0.9rem;
        padding-inline: 1.25rem;
        color: var(--text);
        text-decoration: none;
        font-size: 1.1rem;
    }

    header {
        display: flex;
        align-items: center;
    }
    .menu-toggle {
        display: none;
    }

    @media (max-width: 650px) {
        .menu-toggle {
            display: block;
        }

        /* header{} */
        nav:has(:focus) ul {
            display: flex;
        }
        nav {
            order: 1;
        }
        ul {
            flex-direction: column;
        }
        ul {
            display: none;
            position: fixed;
            top: 6rem;
            right: 1rem;
        }

        a {
            padding-inline: 3rem;
            text-align: center;
        }
    }
</style>
